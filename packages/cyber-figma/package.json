{
	"name": "cyber-figma",
	"version": "0.0.0",
	"description": "Figma CLI and MCP server for AI agents",
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/cyber-figma.git"
	},
	"author": "unional <homawong@gmail.com>",
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.system.*",
		"skills",
		"plugin.json",
		"mcp.json",
		".mcp.json",
		".claude-plugin",
		".cursor-plugin",
		".codex-plugin"
	],
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./mcp": {
			"import": "./dist/mcp.js",
			"types": "./dist/mcp.d.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"cyber-figma": "tsx src/cli.ts",
		"dev": "tsx src/cli.ts",
		"format": "biome format --write .",
		"test": "vitest run src",
		"test:system": "vitest run --config vitest.system.config.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@figma/rest-api-spec": "^0.41.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"commander": "^15.0.0",
		"zod": "^4.4.3"
	},
	"bin": {
		"cyber-figma": "./dist/cli.js"
	}
}
