{
	"$schema": "https://raw.githubusercontent.com/cyberuni/universal-plugin/refs/heads/main/schema/v1.json",
	"name": "cyber-figma",
	"version": "0.0.0",
	"description": "Figma CLI and MCP server for AI agents",
	"author": { "name": "unional" },
	"homepage": "https://github.com/cyberuni/cyber-figma",
	"repository": "https://github.com/cyberuni/cyber-figma.git",
	"license": "MIT",
	"keywords": ["figma", "mcp", "cli", "agent", "design"],
	"skills": "./skills/",
	"mcpServers": {
		"cyber-figma": {
			"command": "npx",
			"args": ["-y", "cyber-figma", "mcp"],
			"env": {
				"FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
				"FIGMA_TEAM_ID": "${FIGMA_TEAM_ID}"
			}
		}
	},
	"vendors": ["claude-code", "cursor", "codex", "copilot-cli"],
	"vendorExtensions": {
		"claude-code": {},
		"cursor": {
			"category": "design",
			"tags": ["figma", "mcp", "design"]
		},
		"codex": {
			"interface": {
				"displayName": "Cyber Figma",
				"category": "design"
			}
		},
		"copilot-cli": {
			"category": "design",
			"tags": ["figma", "mcp", "design"]
		}
	}
}
