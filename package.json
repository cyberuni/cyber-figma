{
	"name": "cyber-figma-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"cf": "pnpm run --filter=./packages/cyber-figma",
		"check": "biome check",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"engines": {
		"node": ">=22"
	}
}
