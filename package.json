{
	"name": "cyber-figma-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"cf": "pnpm run --filter=./packages/cyber-figma",
		"check": "biome check",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
	"engines": {
		"node": ">=22"
	}
}
