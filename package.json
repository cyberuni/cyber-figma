{
	"name": "cyber-figma-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build && universal-plugin plugin build --root packages/cyber-figma",
		"cf": "pnpm run --filter=./packages/cyber-figma",
		"check": "biome check && universal-plugin plugin build --check --root packages/cyber-figma",
		"check-version": "universal-plugin publish check-version --root packages/cyber-figma",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && pnpm check-version && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && universal-plugin plugin version --from-package --root packages/cyber-figma",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8",
		"universal-plugin": "^0.23.0"
	},
	"packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
	"engines": {
		"node": ">=22"
	}
}
