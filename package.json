{
	"name": "cyber-figma-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"cf": "pnpm run --filter=./packages/cyber-figma",
		"check": "biome check",
		"check:fix": "biome check --write",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && turbo run build typecheck test && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"turbo": "^2.10.8"
	},
	"packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
	"engines": {
		"node": ">=22"
	}
}
